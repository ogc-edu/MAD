<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top toolbar with back button and title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#4285F4"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/note_category_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Biology Notes"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Scrollable formatting buttons (moved here) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#F5F5F5"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/format_toggle_container"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Bold (B) button -->
            <ToggleButton
                android:id="@+id/toggle_bold"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:textOn="B"
                android:textOff="B"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/toggle_button_background"
                android:textColor="@color/toggle_text_color"
                android:layout_marginEnd="8dp" />

            <!-- Italic (I) button -->
            <ToggleButton
                android:id="@+id/toggle_italic"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:textOn="I"
                android:textOff="I"
                android:textStyle="italic"
                android:textSize="16sp"
                android:background="@drawable/toggle_button_background"
                android:textColor="@color/toggle_text_color"
                android:layout_marginEnd="8dp" />

            <!-- Underline (U) button -->
            <ToggleButton
                android:id="@+id/toggle_underline"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:textOn="U"
                android:textOff="U"
                android:textSize="16sp"
                android:background="@drawable/toggle_button_background"
                android:textColor="@color/toggle_text_color"
                android:layout_marginEnd="8dp" />

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#DDDDDD"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp" />

            <!-- Bullet list button -->
            <ToggleButton
                android:id="@+id/toggle_bullet"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:textOn="•"
                android:textOff="•"
                android:textSize="20sp"
                android:background="@drawable/toggle_button_background"
                android:textColor="@color/toggle_text_color"
                android:layout_marginEnd="8dp" />

            <!-- Checklist button -->
            <ToggleButton
                android:id="@+id/toggle_checklist"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:textOn="✓"
                android:textOff="✓"
                android:textSize="16sp"
                android:background="@drawable/toggle_button_background"
                android:textColor="@color/toggle_text_color"
                android:layout_marginEnd="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Last edited info -->
    <TextView
        android:id="@+id/last_edited_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Last edited: Today, 2:30 PM"
        android:textSize="12sp"
        android:textColor="#757575"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"/>

    <!-- Note title -->
    <EditText
        android:id="@+id/note_title_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Note Title"
        android:inputType="text"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@null"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"/>

    <!-- Format status indicator (hidden by default) -->
    <TextView
        android:id="@+id/format_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Active formats: None"
        android:textSize="12sp"
        android:textStyle="italic"
        android:gravity="center"
        android:textColor="#757575"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:visibility="gone"/>

    <!-- Divider between title and content -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"/>

    <!-- Note content -->
    <EditText
        android:id="@+id/note_content_edit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:hint="Start typing your note here..."
        android:inputType="textMultiLine"
        android:background="@null"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textIsSelectable="true"
        android:bufferType="editable"
        android:textSize="16sp"
        android:importantForAutofill="no"/>

    <!-- Bottom action bar with formatting toolbar and save button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:gravity="center_vertical"
        android:padding="8dp">

        <!-- Save button aligned to the right -->
        <Button
            android:id="@+id/btn_save_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:background="@drawable/save_button_background"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Floating AI button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_ai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_dialog_info"
        android:contentDescription="Ask AI"
        app:backgroundTint="#4285F4"
        app:tint="#FFFFFF"
        android:visibility="gone"/>

</LinearLayout>
