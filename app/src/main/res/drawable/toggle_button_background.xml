<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- When selected -->
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="#4285F4" /> <!-- Google Blue when selected -->
            <stroke android:width="1dp" android:color="#2A56C6" />
        </shape>
    </item>
    <!-- When not selected -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#E0E0E0" /> <!-- Light gray when not selected -->
            <stroke android:width="1dp" android:color="#BDBDBD" />
        </shape>
    </item>
</selector>
